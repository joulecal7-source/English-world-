    <tr><td class="num-cell"><div class="num-badge">40</div></td><td class="en-cell">Say hello to your husband.</td><td class="fr-cell">Dis bonjour a ton mari de ma part.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Say hello to your husband.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">41</div></td><td class="en-cell">Give my greetings to your children.</td><td class="fr-cell">Salue tes enfants de ma part.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Give my greetings to your children.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">42</div></td><td class="en-cell">Remember me to your parents.</td><td class="fr-cell">Salue tes parents de ma part.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Remember me to your parents.',this)">&#x1F50A;</button></td></tr>
