    <tr><td class="num-cell"><div class="num-badge">33</div></td><td class="en-cell">Text me later.</td><td class="fr-cell">Envoie-moi un message plus tard.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Text me later.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">34</div></td><td class="en-cell">I will call you later.</td><td class="fr-cell">Je t appellerai plus tard.</td><td class="tts-cell"><button class="tts-btn" onclick="say('I will call you later.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">35</div></td><td class="en-cell">Write to me.</td><td class="fr-cell">Ecris-moi.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Write to me.',this)">&#x1F50A;</button></td></tr>
