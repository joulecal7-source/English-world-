    <tr><td class="num-cell"><div class="num-badge">48</div></td><td class="en-cell">Enjoy your trip.</td><td class="fr-cell">Profite de ton voyage.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Enjoy your trip.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">49</div></td><td class="en-cell">Get home safe.</td><td class="fr-cell">Rentre
