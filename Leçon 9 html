    <tr><td class="num-cell"><div class="num-badge">11</div></td><td class="en-cell">It was a pleasure to be with you.</td><td class="fr-cell">C etait un plaisir d etre avec vous.</td><td class="tts-cell"><button class="tts-btn" onclick="say('It was a pleasure to be with you.',this)">&#x1F50A;</button></td></tr>
