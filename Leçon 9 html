    <tr><td class="num-cell"><div class="num-badge">17</div></td><td class="en-cell">May God protect you.</td><td class="fr-cell">Que Dieu vous protege.</td><td class="tts-cell"><button class="tts-btn" onclick="say('May God protect you.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">18</div></td><td class="en-cell">May God be with you.</td><td class="fr-cell">Que Dieu soit avec vous.</td><td class="tts-cell"><button class="tts-btn" onclick="say('May God be with you.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">19</div></td><td class="en-cell">May God guide you.</td><td class="fr-cell">Que Dieu vous guide.</td><td class="tts-cell"><button class="tts-btn" onclick="say('May God guide you.',this)">&#x1F50A;</button></td></tr>
