    <tr><td class="num-cell"><div class="num-badge">25</div></td><td class="en-cell">You will remain in my mind forever.</td><td class="fr-cell">Vous resterez dans mon esprit pour toujours.</td><td class="tts-cell"><button class="tts-btn" onclick="say('You will remain in my mind forever.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">26</div></td><td class="en-cell">I will never forget you.</td><td class="fr-cell">Je ne vous oublierai jamais.</td><td class="tts-cell"><button class="tts-btn" onclick="say('I will never forget you.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">27</div></td><td class="en-cell">I will never forsake you.</td><td class="fr-cell">Je ne vous abandonnerai jamais.</td><td class="tts-cell"><button class="tts-btn" onclick="say('I will never forsake you.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">28</div></td><td class="en-cell">You are in my heart.</td><td class="fr-cell">Vous etes dans mon coeur.</td><td class="tts-cell"><button class="tts-btn" onclick="say('You are in my heart.',this)">&#x1F50A;</button></td></tr>
    <tr><td class="num-cell"><div class="num-badge">29</div></td><td class="en-cell">I will think of you.</td><td class="fr-cell">Je penserai a vous.</td><td class="tts-cell"><button class="tts-btn" onclick="say('I will think of you.',this)">&#x1F50A;</button></td></tr>
  </table>
</div>

<!-- SECTION 5 -->
<div class="card">
  <div class="ch blue">&#x1F4DE; 5. Rester en contact</div>
  <table class="phrase-table">
    <tr><td class="num-cell"><div class="num-badge">30</div></td><td class="en-cell">Stay in touch.</td><td class="fr-cell">Restons en contact.</td><td class="tts-cell"><button class="tts-btn" onclick="say('Stay in touch.',this)">&#x1F50A;</button></td></tr>
