<!-- SECTION 4 -->
<div class="card">
  <div class="ch red">&#x2764;&#xFE0F; 4. Les promesses et sentiments profonds</div>
  <table class="phrase-table">
    <tr><td class="num-cell"><div class="num-badge">23</div></td><td class="en-cell">I will miss you.</td><td class="fr-cell">Tu me manqueras.</td><td class="tts-cell"><button class="tts-btn" onclick="say('I will miss you.',this)">&#x1F50A;</button></td></tr>
